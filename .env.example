# FinTrack environment variables — copy to .env and fill in real values.
# .env is gitignored; .env.example is committed as the template.

# ---------- Java flavor ----------
JAVA_FLAVOR=java21

# ---------- Spring Cloud Config Server ----------
CONFIG_SERVER_USER=changeme
CONFIG_SERVER_PASSWORD=changeme

# ---------- Eureka service registry ----------
EUREKA_USER=changeme
EUREKA_PASSWORD=changeme

# ---------- MySQL (shared across the 4 per-service DBs) ----------
MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=changeme
MYSQL_PASSWORD=changeme

# ---------- RabbitMQ ----------
RABBITMQ_USER=changeme
RABBITMQ_PASSWORD=changeme

# ---------- Grafana ----------
GRAFANA_USER=changeme
GRAFANA_PASSWORD=changeme
