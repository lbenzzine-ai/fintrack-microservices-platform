# FinTrack environment variables — copy to .env and fill in real values.
# .env is gitignored; .env.example is committed as the template.

# ---------- Java flavor ----------
JAVA_FLAVOR=java21

# ---------- Spring Cloud Config Server ----------
CONFIG_SERVER_USER=changeme
CONFIG_SERVER_PASSWORD=changeme

# ---------- Eureka service registry ----------
EUREKA_USER=changeme
EUREKA_PASSWORD=changeme
# Full registry URL used by service clients (local-run default; docker-compose builds its own).
EUREKA_SERVER_URL=http://changeme:changeme@localhost:8761/eureka

# ---------- MySQL (consolidated — used by docker-compose container env) ----------
MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=changeme
MYSQL_PASSWORD=changeme

# ---------- MySQL (per-DB — used by Spring Cloud Config served YAML) ----------
MYSQL_USERS_USER=changeme
MYSQL_USERS_PASSWORD=changeme
MYSQL_ACCOUNTS_USER=changeme
MYSQL_ACCOUNTS_PASSWORD=changeme
MYSQL_TRANSACTIONS_USER=changeme
MYSQL_TRANSACTIONS_PASSWORD=changeme
MYSQL_NOTIFICATIONS_USER=changeme
MYSQL_NOTIFICATIONS_PASSWORD=changeme

# ---------- RabbitMQ ----------
RABBITMQ_USER=changeme
RABBITMQ_PASSWORD=changeme
# Spring rabbitmq.password placeholder (separate var name in served config).
RABBITMQ_PASS=changeme

# ---------- Grafana ----------
GRAFANA_USER=changeme
GRAFANA_PASSWORD=changeme
