{
  "info": {
    "_postman_id": "fintrack-collection-001",
    "name": "FinTrack",
    "description": "End-to-end collection covering auth + user, account, transaction and notification flows. Set the {{baseUrl}} variable to your api-gateway host (default http://localhost:8080). The login request stashes the returned JWT into {{token}} so the rest of the requests just work.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token",   "value": "" },
    { "key": "userUuid","value": "" },
    { "key": "accountUuid","value": "" },
    { "key": "transactionUuid","value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"correct horse battery staple\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const body = pm.response.json();",
              "  if (body.uuid) pm.collectionVariables.set('userUuid', body.uuid);",
              "}"
            ], "type": "text/javascript" }
          }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"correct horse battery staple\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const body = pm.response.json();",
              "if (body.token) pm.collectionVariables.set('token', body.token);"
            ], "type": "text/javascript" }
          }]
        }
      ]
    },

    {
      "name": "Users",
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me"] }
          }
        }
      ]
    },

    {
      "name": "Accounts",
      "item": [
        {
          "name": "Open my wallet",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userUuid}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/accounts", "host": ["{{baseUrl}}"], "path": ["api","v1","accounts"] },
            "body": { "mode": "raw", "raw": "{\n  \"currencyCode\": \"USD\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const body = pm.response.json();",
              "  if (body.uuid) pm.collectionVariables.set('accountUuid', body.uuid);",
              "}"
            ], "type": "text/javascript" }
          }]
        },
        {
          "name": "Get balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/accounts/{{accountUuid}}/balance", "host": ["{{baseUrl}}"], "path": ["api","v1","accounts","{{accountUuid}}","balance"] }
          }
        },
        {
          "name": "Interest preview (Strategy)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountUuid}}/interest/preview?annualRate=0.03&months=12&strategy=tiered",
              "host": ["{{baseUrl}}"], "path": ["api","v1","accounts","{{accountUuid}}","interest","preview"],
              "query": [
                { "key": "annualRate", "value": "0.03" },
                { "key": "months", "value": "12" },
                { "key": "strategy", "value": "tiered" }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "Transactions",
      "item": [
        {
          "name": "Fee quote",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/fee/quote?type=DOMESTIC_TRANSFER&amount=100.00&currencyCode=USD",
              "host": ["{{baseUrl}}"], "path": ["api","v1","transactions","fee","quote"],
              "query": [
                { "key": "type", "value": "DOMESTIC_TRANSFER" },
                { "key": "amount", "value": "100.00" },
                { "key": "currencyCode", "value": "USD" }
              ]
            }
          }
        },
        {
          "name": "Initiate transfer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api","v1","transactions"] },
            "body": { "mode": "raw", "raw": "{\n  \"fromAccountUuid\": \"{{accountUuid}}\",\n  \"toAccountUuid\":   \"00000000-0000-0000-0000-000000000001\",\n  \"amount\": 50.00,\n  \"currencyCode\": \"USD\",\n  \"type\": \"DOMESTIC_TRANSFER\",\n  \"description\": \"Postman test\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const body = pm.response.json();",
              "  if (body.uuid) pm.collectionVariables.set('transactionUuid', body.uuid);",
              "}"
            ], "type": "text/javascript" }
          }]
        },
        {
          "name": "Get transaction",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/transactions/{{transactionUuid}}", "host": ["{{baseUrl}}"], "path": ["api","v1","transactions","{{transactionUuid}}"] }
          }
        },
        {
          "name": "ATM withdrawal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api","v1","transactions"] },
            "body": { "mode": "raw", "raw": "{\n  \"fromAccountUuid\": \"{{accountUuid}}\",\n  \"amount\": 80.00,\n  \"currencyCode\": \"USD\",\n  \"type\": \"ATM_WITHDRAWAL\"\n}" }
          }
        }
      ]
    },

    {
      "name": "Notifications",
      "item": [
        {
          "name": "Send email (direct)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/notifications", "host": ["{{baseUrl}}"], "path": ["api","v1","notifications"] },
            "body": { "mode": "raw", "raw": "{\n  \"recipient\": \"alice@example.com\",\n  \"channel\": \"EMAIL\",\n  \"template\": \"welcome\",\n  \"subject\": \"Hello\",\n  \"payload\": { \"username\": \"alice\" }\n}" }
          }
        },
        {
          "name": "Upsert preferences",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/notifications/preferences/{{userUuid}}", "host": ["{{baseUrl}}"], "path": ["api","v1","notifications","preferences","{{userUuid}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"emailEnabled\": true,\n  \"smsEnabled\":   false,\n  \"pushEnabled\":  true,\n  \"emailAddress\": \"alice@example.com\"\n}" }
          }
        }
      ]
    }
  ]
}
