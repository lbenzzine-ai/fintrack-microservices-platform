{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "FinTrack JVM Overview",
  "uid": "fintrack-jvm",
  "tags": ["fintrack","jvm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(jvm_memory_used_bytes, application)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Heap used",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\", application=~\"$service\"})", "legendFormat": "{{application}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC pause (p99)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, application) (rate(jvm_gc_pause_seconds_bucket{application=~\"$service\"}[5m])))", "legendFormat": "{{application}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$service\"}[1m]))", "legendFormat": "{{application}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Service method p95 (from PerformanceAspect)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, method) (rate(fintrack_service_method_seconds_bucket[5m])))", "legendFormat": "{{method}}" }
      ]
    }
  ]
}
